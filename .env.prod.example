# ==========================================================
# PROD — branch main (EasyPanel: <projeto>-prod)
#
# Cole no Ambiente do serviço EasyPanel desta branch (ou copie
# para .env ao rodar local). Troque todos os segredos:
# ./scripts/generate-secrets.sh
# ==========================================================

# Nome do projeto no Docker Compose (prefixo de containers e volumes)
COMPOSE_PROJECT_NAME=app-prod
TZ=America/Sao_Paulo

# dev    = Django e Expo rodam o workspace do Code Server (hot reload)
# server = Django e Expo rodam o código da branch (gunicorn + Nginx)
RUN_MODE=server

# ---------- Code Server ----------
CODER_PASSWORD=troque-esta-senha

# Git / GitHub (aplicados a cada inicialização do container).
# GH_TOKEN: token fine-grained restrito ao repositório do projeto,
# com Contents (read/write) e Pull requests (read/write).
# Vazio = login interativo no primeiro terminal.
GIT_USER_NAME=
GIT_USER_EMAIL=
GH_TOKEN=

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=troque-esta-chave
# Hosts e origens: separe por vírgula.
DJANGO_ALLOWED_HOSTS=api-projeto.exemplo.com
CORS_ALLOWED_ORIGINS=https://projeto.exemplo.com

# Gunicorn (só em RUN_MODE=server)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---------- PostgreSQL ----------
DB_NAME=app_prod
DB_USER=app_prod
DB_PASSWORD=troque-esta-senha

# ---------- Expo ----------
# URL pública da API deste ambiente (domínio do serviço django).
# Em RUN_MODE=server é embutida no build: mudou → reimplante.
API_URL=https://api-projeto.exemplo.com

# Variáveis da API (serviços api, worker, beat). Mesmas CHAVES em hom e prod; valores diferentes.
# Preencher no EasyPanel de cada projeto (<produto>-hom / <produto>-prod). Nunca versionar valores.

# ------------------------------------------------ comuns
APP_ENV=hom                                   # hom | prod
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<única por ambiente>
DJANGO_ALLOWED_HOSTS=api.hom.produto.com.br   # prod: api.produto.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.hom.produto.com.br
CORS_ALLOWED_ORIGINS=https://app.hom.produto.com.br
DATABASE_URL=postgres://app:<senha>@<produto>-hom_postgres:5432/app
CELERY_BROKER_URL=redis://default:<senha>@<produto>-hom_redis:6379/0
REDIS_CACHE_URL=redis://default:<senha>@<produto>-hom_redis:6379/1
CACHE_KEY_PREFIX=<produto>-hom
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# RELEASE não é env do painel: vem embutido na imagem

# hom: obrigatório (e-mails/telefones da equipe). prod: vazio.
OUTBOUND_ALLOWLIST=equipe@produto.com.br,+5514999999999

# storage (BE-05) — bucket próprio do ambiente
STORAGE_ENDPOINT_URL=https://minio.hom.produto.com.br
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=produto-hom
STORAGE_REGION=us-east-1

# integrações / IA — hom SEMPRE sandbox
# ASAAS_API_KEY= · EVOLUTION_API_URL= · EVOLUTION_API_KEY= · ANTHROPIC_API_KEY= · EXPO_ACCESS_TOKEN=

# ------------------------------------------------ só api
ROLE=web
RUN_MIGRATIONS=1
GUNICORN_WORKERS=3            # hom: 1

# ------------------------------------------------ só worker
# ROLE=worker
# CELERY_QUEUES=default,integrations,ai
# CELERY_CONCURRENCY=2        # hom: 1

# ------------------------------------------------ só beat (1 réplica)
# ROLE=beat
# CELERY_BEAT_ARGS=--scheduler django_celery_beat.schedulers:DatabaseScheduler

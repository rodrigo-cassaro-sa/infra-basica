{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "dev", "EXPO_PUBLIC_API_URL": "http://192.168.0.10:8000" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "hom", "EXPO_PUBLIC_API_URL": "https://api.hom.produto.com.br" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_APP_ENV": "prod", "EXPO_PUBLIC_API_URL": "https://api.produto.com.br" }
    }
  },
  "submit": { "production": {} }
}

# Web do app Expo (web.output: "static") servida por Caddy como site estático.
# A MESMA imagem roda em hom e prod: a URL da API NÃO entra no build.
# Ela é escrita em /config.js quando o container sobe (docker-entrypoint.sh), a partir das envs.
# Build: docker buildx build --build-arg RELEASE=$(git rev-parse HEAD:app) -f app/Dockerfile app/

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npx expo export -p web

FROM caddy:2-alpine
ARG RELEASE=dev
ENV RELEASE=$RELEASE \
    XDG_CONFIG_HOME=/tmp/caddy-config \
    XDG_DATA_HOME=/tmp/caddy-data
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY --from=build /app/dist /srv
RUN adduser -D -u 10001 web \
    && chmod +x /usr/local/bin/docker-entrypoint.sh \
    && chown -R web:web /srv
USER web
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

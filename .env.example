# ==========================================================
# TEMPLATE DE PROJETO - COPIE PARA .env E TROQUE OS SEGREDOS
#
# Local: um .env com tudo. No EasyPanel, cada serviço Compose
# (<projeto>-dev, -hom, -prod) recebe só as variáveis do próprio
# ambiente (prefixo DEV_, HOM_ ou PROD_) + TZ. Code Server e Git
# vão só no <projeto>-dev.
# ==========================================================
# Nome do projeto no Docker Compose (prefixo de containers e volumes)
COMPOSE_PROJECT_NAME=app
TZ=America/Sao_Paulo

# Code Server
CODER_PASSWORD=troque-esta-senha

# Git / GitHub do Code Server (aplicados a cada inicialização do container).
# GH_TOKEN: token fine-grained do GitHub, restrito ao repositório do projeto,
# com permissão Contents (read/write) e Pull requests (read/write).
# Deixe vazio para fazer o login interativo no primeiro terminal.
GIT_USER_NAME=
GIT_USER_EMAIL=
GH_TOKEN=

# Django secrets
DJANGO_SECRET_KEY_DEV=dev-troque-esta-chave
DJANGO_SECRET_KEY_HOM=hom-troque-esta-chave
DJANGO_SECRET_KEY_PROD=prod-troque-esta-chave

# PostgreSQL DEV
DEV_DB_NAME=app_dev
DEV_DB_USER=app_dev
DEV_DB_PASSWORD=troque-senha-dev

# PostgreSQL HOM
HOM_DB_NAME=app_hom
HOM_DB_USER=app_hom
HOM_DB_PASSWORD=troque-senha-hom

# PostgreSQL PROD
PROD_DB_NAME=app_prod
PROD_DB_USER=app_prod
PROD_DB_PASSWORD=troque-senha-prod

# Hosts do Django. Separe por vírgula.
DEV_ALLOWED_HOSTS=*
HOM_ALLOWED_HOSTS=*
PROD_ALLOWED_HOSTS=*

# URLs públicas das APIs usadas pelo Expo/Web.
# No EasyPanel, crie um domínio para cada serviço django-* e coloque aqui.
DEV_API_URL=https://api-dev.exemplo.com
HOM_API_URL=https://api-hom.exemplo.com
PROD_API_URL=https://api.exemplo.com

# Gunicorn (HOM/PROD)
HOM_GUNICORN_WORKERS=3
HOM_GUNICORN_TIMEOUT=60
PROD_GUNICORN_WORKERS=3
PROD_GUNICORN_TIMEOUT=60

# CORS do Django. Separe por vírgula.
DEV_CORS_ALLOWED_ORIGINS=https://dev-app.exemplo.com
HOM_CORS_ALLOWED_ORIGINS=https://hom-app.exemplo.com
PROD_CORS_ALLOWED_ORIGINS=https://app.exemplo.com

# ==========================================================
# HOM — branch hom (EasyPanel: <projeto>-hom)
#
# Cole no Ambiente do serviço EasyPanel desta branch (ou copie
# para .env ao rodar local). Troque todos os segredos:
# ./scripts/generate-secrets.sh
# ==========================================================

# Nome do projeto no Docker Compose (prefixo de containers e volumes)
COMPOSE_PROJECT_NAME=app-hom
TZ=America/Sao_Paulo

# dev    = Django e Expo rodam o workspace do Code Server (hot reload)
# server = Django e Expo rodam o código da branch (gunicorn + Nginx)
RUN_MODE=server

# ---------- Code Server ----------
# Desligado neste ambiente: o código vem só da branch.
# Para ligar (ex.: diagnóstico), adicione COMPOSE_PROFILES=coder
# e as variáveis do Code Server de .env.dev.example.
COMPOSE_PROFILES=

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.homologation
DJANGO_SECRET_KEY=troque-esta-chave
# Hosts e origens: separe por vírgula.
DJANGO_ALLOWED_HOSTS=api-hom-projeto.exemplo.com
CORS_ALLOWED_ORIGINS=https://hom-projeto.exemplo.com

# Gunicorn (só em RUN_MODE=server)
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# ---------- PostgreSQL ----------
DB_NAME=app_hom
DB_USER=app_hom
DB_PASSWORD=troque-esta-senha

# ---------- Expo ----------
# URL pública da API deste ambiente (domínio do serviço django).
# Em RUN_MODE=server é embutida no build: mudou → reimplante.
API_URL=https://api-hom-projeto.exemplo.com
